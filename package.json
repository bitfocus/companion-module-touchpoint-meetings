{
	"name": "touchpoint-meetings",
	"version": "0.2.1",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "npm run build && companion-module-build",
		"build": "rimraf dist && npm run embed && npm run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "npm run embed && tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "npm run lint:raw .",
		"embed": "node scripts/embed-script.mjs",
		"version:set": "node scripts/set-version.mjs",
		"release": "node scripts/release.mjs",
		"release:tag": "node scripts/tag-release.mjs",
		"test": "vitest run",
		"test:py": "python -m unittest discover -s test/python -v"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-touchpoint-meetings.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^22.19.17",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"eslint --fix"
		]
	},
	"packageManager": "yarn@4.17.0"
}
